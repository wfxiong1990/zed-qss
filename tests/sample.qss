/* QSS */
QPushButton#closeButton:hover {
    border-image: $image(mainwindow.close)$ 0 68 0 0;
    color: $color(window.text)$;
    font: $font(font1)$;
    qproperty-icon: url(icon.png);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #fff, stop:1 #000);
}
QScrollBar::add-line:horizontal {
    width: 12px;
}
QTreeView::item:selected:!active {
    color: $color(tree.selected)$;;
}
