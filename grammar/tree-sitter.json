{
  "grammars": [
    {
      "name": "qss",
      "camelcase": "QSS",
      "scope": "source.qss",
      "path": ".",
      "file-types": ["qss"],
      "injection-regex": "^qss$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Qt Style Sheets grammar based on tree-sitter-css",
    "authors": [
      {"name": "Max Brunsfeld"},
      {"name": "Amaan Qureshi"}
    ]
  },
  "bindings": {"c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false}
}
